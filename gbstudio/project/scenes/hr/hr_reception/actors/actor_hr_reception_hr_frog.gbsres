          {
            "id": "7ce77e2c-2260-52fd-baf2-49dd95fa87d3",
            "command": "EVENT_TEXT",
            "args": {
              "text": "I'm not supposed\nto\nsay anything.",
              "avatarId": ""
            }
          },
          {
            "id": "84b02836-7660-5800-8835-62bf05eaa67e",
            "command": "EVENT_TEXT",
            "args": {
              "text": "But there's a\nfolder. In\nComplaints.",
              "avatarId": ""
            }
          },
          {
            "id": "5aabed84-bdfc-5ae7-8a9f-a9cebc2de73d",
            "command": "EVENT_TEXT",
            "args": {
              "text": "It's... a plan.\nA big one.",
              "avatarId": ""
            }
          },
          {
            "id": "39b2c884-4541-5bb3-ba3a-19697a596816",
            "command": "EVENT_TEXT",
            "args": {
              "text": "You'll need a\nkeycard. Try the\nPersonnel Files.",
              "avatarId": ""
            }
          },
          {
            "id": "26b9f91b-5e74-566b-af8f-ab4f2e772e10",
            "command": "EVENT_TEXT",
            "args": {
              "text": "And Bufo? Be\ncareful. *nervous\nsip*",
              "avatarId": ""
            }
          },
          {
            "id": "1682765f-ef66-5c97-bae4-bdcf0eda4452",
            "command": "EVENT_SET_VALUE",
            "args": {
              "variable": "61",
              "value": {
                "type": "true"
              }
            }
          }
        ]
      }
