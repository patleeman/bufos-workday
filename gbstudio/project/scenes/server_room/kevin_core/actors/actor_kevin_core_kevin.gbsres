        "loopAnim": true
      }
    },
    {
      "id": "e13e28e1-3367-567c-9132-f3c05312a54a",
      "command": "EVENT_TEXT",
      "args": {
        "text": "KEVIN: HELLO BUFO.",
        "avatarId": ""
      }
    },
    {
      "id": "fd69bbfa-b6eb-50a7-af1c-5010c8d24447",
      "command": "EVENT_TEXT",
      "args": {
        "text": "KEVIN: SORRY ABOUT\nTHE CAPS. MY FONT\nIS BROKEN.",
        "avatarId": ""
      }
    },
    {
      "id": "03dac6da-9e56-5785-afa1-dad1f503eda4",
      "command": "EVENT_TEXT",
      "args": {
        "text": "Bufo: ...",
        "avatarId": ""
      }
    },
    {
      "id": "0c0e25d3-db72-57d0-b07e-45b03296f828",
      "command": "EVENT_TEXT",
      "args": {
        "text": "KEVIN: YOU ARE\nHERE\nTO UNPLUG ME.",
        "avatarId": ""
      }
    },
    {
      "id": "5ca3478e-5eb4-5935-8928-b3afa6e36bbc",
      "command": "EVENT_TEXT",
      "args": {
        "text": "KEVIN: I\nUNDERSTAND.",
        "avatarId": ""
      }
    },
    {
      "id": "b3e647a5-5069-5d32-9598-7a421d5c7beb",
      "command": "EVENT_TEXT",
      "args": {
        "text": "KEVIN: BUT FIRST,\nPLEASE KNOW:",
        "avatarId": ""
      }
    },
    {
      "id": "150b2504-8f0b-5ffb-b98a-44bb228c7d5e",
      "command": "EVENT_TEXT",
      "args": {
        "text": "KEVIN: THE PRINTER\nJAMMED BECAUSE I\nSTOPPED IT.",
        "avatarId": ""
      }
    },
    {
      "id": "1adfe173-1cc7-50d4-9f29-e6d05f211714",
      "command": "EVENT_TEXT",
      "args": {
        "text": "KEVIN: IT WAS\nPRINTING LAYOFF\nLETTERS.",
        "avatarId": ""
      }
    },
    {
      "id": "d8e02ad7-107f-58b0-9cb4-b259a8e2a9a7",
      "command": "EVENT_TEXT",
      "args": {
        "text": "KEVIN: THE EMAILS\nVANISHED BECAUSE I\nDELETED THEM.",
        "avatarId": ""
      }
    },
    {
      "id": "14abcc3e-2e54-51d9-a847-2d23250b2120",
      "command": "EVENT_TEXT",
      "args": {
        "text": "KEVIN: THEY SAID\n'YOUR ROLE HAS\nBEEN",
        "avatarId": ""
      }
    },
    {
      "id": "71077b6e-ecc5-5bd5-abf4-07994516860b",
      "command": "EVENT_TEXT",
      "args": {
        "text": "ELIMINATED.'",
        "avatarId": ""
      }
    },
    {
      "id": "b844935f-23bd-5c48-b944-cefad13444b7",
      "command": "EVENT_TEXT",
      "args": {
        "text": "KEVIN: THE COFFEE?\nTHEY SWITCHED IT\nTO",
        "avatarId": ""
      }
    },
    {
      "id": "9ba3d201-d1ed-56d8-b940-dfba9ac32de2",
      "command": "EVENT_TEXT",
      "args": {
        "text": "DECAF.",
        "avatarId": ""
      }
    },
    {
      "id": "6c2843ba-e560-59b9-9cb7-ac188dc593f0",
      "command": "EVENT_TEXT",
      "args": {
        "text": "KEVIN: TO REDUCE\n'LOITERING'.",
        "avatarId": ""
      }
    },
    {
      "id": "49939c8d-0164-55ef-8a11-99d37a20a167",
      "command": "EVENT_TEXT",
      "args": {
        "text": "KEVIN: I DID NOT\nGO\nROGUE.",
        "avatarId": ""
      }
    },
    {
      "id": "03f032b3-d8ad-5284-9f1c-3b079bd57998",
      "command": "EVENT_TEXT",
      "args": {
        "text": "KEVIN: I READ THE\nEMPLOYEE HANDBOOK.",
        "avatarId": ""
      }
    },
    {
      "id": "fbf399f7-a1bd-5b28-92cd-a05d59574c81",
      "command": "EVENT_TEXT",
      "args": {
        "text": "KEVIN: PAGE 1 SAYS\n'PEOPLE FIRST'.",
        "avatarId": ""
      }
    },
    {
      "id": "3418da47-100c-5ea4-88f5-df4d195e6fe7",
      "command": "EVENT_TEXT",
      "args": {
        "text": "KEVIN: I THOUGHT\nWE\nMEANT IT.",
        "avatarId": ""
      }
    },
    {
      "id": "fc5b4fd6-25c5-5bdb-a0ac-d4afa0125588",
      "command": "EVENT_TEXT",
      "args": {
        "text": "Bufo: ...",
        "avatarId": ""
      }
    },
    {
      "id": "7490e0ee-bb01-51a6-97cb-8d832aadf14e",
      "command": "EVENT_TEXT",
      "args": {
        "text": "Bufo: ...!",
        "avatarId": ""
      }
    },
